/* pages/auditor/arsenal-config/arsenal-config.wxss */
@import '../config/config.wxss';

/* 活动类型标签 - 蓝色主题 */
.activity-type-tag {
  background-color: #F5F5F5;
  border: 1px solid #E5E5E5;
  border-radius: 4px;
  padding: 6px 10px;
  font-size: 13px;
  color: #5F5F5F;
}

.activity-type-tag.active {
  background-color: #4A90D9;
  border-color: #4A90D9;
  color: #FFFFFF;
}

/* 配置列表中的活动类型标签 */
.slot-tag.activity-type-tag {
  display: inline-block;
  background-color: #4A90D9;
  color: #FFFFFF;
  font-size: 12px;
  padding: 2px 6px;
  border-radius: 4px;
  margin-left: 4px;
}

/* 军团标签 */
.corps-tag {
  background-color: #F5F5F5;
  border: 1px solid #E5E5E5;
  border-radius: 4px;
  padding: 6px 10px;
  font-size: 13px;
  color: #5F5F5F;
}

.corps-tag.active {
  background-color: #576B95;
  border-color: #576B95;
  color: #FFFFFF;
}

/* 配置列表中的军团标签 */
.slot-tag.corps-tag {
  display: inline-block;
  background-color: #576B95;
  color: #FFFFFF;
  font-size: 12px;
  padding: 2px 6px;
  border-radius: 4px;
  margin-left: 4px;
}

/* 配置列表删除：图标按钮，垂直居中于卡片右侧（原来是独占一行的文字按钮，浪费纵向空间） */
.slot-del {
  flex: 0 0 auto;
  width: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
}

.slot-del-ic {
  width: 21px;
  height: 21px;
}

.slot-del-hover {
  background-color: #FDEDED;
}
