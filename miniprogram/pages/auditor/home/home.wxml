<view class="page">
  <!-- 账号卡：右侧挂「当前联盟」
       分区切换统一在首页；此页不再显示分区（任何角色，含超管），只展示角色 + 当前联盟 -->
  <view class="card mt-16">
    <view class="card-body flex items-center">
      <image class="avatar-lg" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" />
      <view class="ml-16 acct-info">
        <text class="text-lg font-semibold acct-name">{{userInfo.nickName || '未登录'}}</text>
        <view class="flex items-center mt-8">
          <view class="status-dot status-active"></view>
          <text class="text-secondary acct-role">{{roleDisplayName}}</text>
        </view>
      </view>

      <!-- 联盟选择器：放在账号框内右侧 -->
      <view class="acct-alliance">
        <text class="acct-alliance-label">联盟</text>

        <!-- 超管：当前分区下的全部联盟 -->
        <block wx:if="{{isSuperAdmin}}">
          <alliance-picker wx:if="{{alliances.length > 0}}" alliances="{{alliances}}" value="{{allianceIndex}}"
                           placeholder="请选择" bind:change="onAllianceChange" />
          <view wx:else class="zone-readonly">暂无联盟</view>
        </block>

        <!-- 区管：本分区下的联盟；盟管：本人绑定的联盟（不再在选项里显示分区） -->
        <block wx:elif="{{myAlliances.length > 1}}">
          <alliance-picker alliances="{{myAlliances}}" value="{{selectedAllianceIndex}}"
                           placeholder="请选择" bind:change="onMyAllianceChange" />
        </block>
        <block wx:elif="{{myAlliances.length === 1}}">
          <view class="zone-readonly">{{myAlliances[0].allianceName}}</view>
        </block>
        <block wx:else>
          <view class="zone-readonly">暂未绑定</view>
        </block>
      </view>
    </view>
  </view>

  <!-- 配置管理 -->
  <view class="section-header">
    <text class="section-title">配置管理</text>
  </view>
  <view class="function-grid">
    <view class="function-card-compact" bindtap="goToConfig">
      <view class="function-content">
        <text class="function-name">堡垒配置</text>
        <text class="function-desc">配置活动时间和标签</text>
      </view>
    </view>
    <view class="function-card-compact" bindtap="goToArsenalConfig">
      <view class="function-content">
        <text class="function-name">兵工厂&峡谷</text>
        <text class="function-desc">生成联盟活动时间进行报名</text>
      </view>
    </view>
  </view>

  <!-- 统计数据 -->
  <view class="section-header mt-24">
    <text class="section-title">统计数据</text>
  </view>
  <view class="function-grid">
    <view class="function-card-compact" bindtap="goToAllianceActivity">
      <view class="function-content">
        <text class="function-name">联盟活跃</text>
        <text class="function-desc">登记联盟活跃成员</text>
      </view>
    </view>
    <view class="function-card-compact" bindtap="goToStatistics">
      <view class="function-content">
        <text class="function-name">数据统计</text>
        <text class="function-desc">查看联盟统计</text>
      </view>
    </view>
    <view class="function-card-compact" bindtap="goToClearData">
      <view class="function-content">
        <text class="function-name">清空数据</text>
        <text class="function-desc">清空报名记录</text>
      </view>
    </view>
  </view>
</view>
