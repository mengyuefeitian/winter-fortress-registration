<view class="ad-gate-container">
  <!-- 机制说明 -->
  <view class="info-section">
    <view class="info-title">高级功能解锁</view>
    <view class="info-content">
      用户完成一次激励任务，即可解锁本周（{{weekRange}}）全部高级功能权限，本周内无需重复。
    </view>
    <view class="info-tip">
      开关只需配置一次、长期有效，不会每周失效；上方日期是按当前时间自动计算的。用户的解锁状态每周一 00:00 自动重置，需重新完成一次。
    </view>
    <view class="info-warning">
      ⚠️ 报名属高频核心操作，开启后请留意用户反馈与平台合规要求，必要时及时关闭。
    </view>
    <view class="info-warning">
      修改后本机立即生效；其他用户端最长 5 分钟后生效，无需发版。
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-section">
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:else>
    <!-- 开关 -->
    <view class="switch-section">
      <view class="switch-row">
        <view class="switch-main">
          <text class="switch-label">报名类</text>
          <text class="switch-desc">熊坑 / 国战 / 官职报名</text>
        </view>
        <switch checked="{{registerGate}}" bindchange="onRegisterGateChange" color="#07C160" />
      </view>
      <view class="switch-row switch-row-bordered">
        <view class="switch-main">
          <text class="switch-label">增值类</text>
          <text class="switch-desc">保存截图、第 2 个以上游戏账号</text>
        </view>
        <switch checked="{{valueGate}}" bindchange="onValueGateChange" color="#07C160" />
      </view>
    </view>

    <!-- 当前状态 -->
    <view class="preview-section">
      <view class="preview-title">当前状态</view>
      <view class="preview-content">报名类：{{registerGate ? '激励解锁后可用' : '直接开放'}}</view>
      <view class="preview-content">增值类：{{valueGate ? '激励解锁后可用' : '直接开放'}}</view>
      <view class="preview-content">生效周期：{{weekRange}}</view>
    </view>

    <!-- 保存 -->
    <view class="save-section">
      <button class="save-btn" disabled="{{saving || !dirty}}" bindtap="save">
        {{saving ? '保存中...' : '保存配置'}}
      </button>
    </view>
  </block>
</view>
