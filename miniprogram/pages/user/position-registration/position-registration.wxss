/* pages/user/position-registration/position-registration.wxss */
/* 微信设计语言风格 */

/* 页面容器 */
.page {
  min-height: 100vh;
  background-color: #F6F6F6;
}

/* 刷新按钮 */
.refresh-btn {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 6px 12px;
  background-color: #07C160;
  border-radius: 4px;
}

.refresh-icon-text {
  font-size: 16px;
  color: #FFFFFF;
}

.refresh-text {
  font-size: 13px;
  color: #FFFFFF;
}

.refresh-btn:active {
  background-color: #06AD56;
}

/* 配置信息卡片 */
.card {
  background-color: #FFFFFF;
  border-radius: 8px;
  margin: 16px;
  padding: 12px 16px;
  box-shadow: none;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 8px;
  border-bottom: 1px solid #F0F0F0;
}

.card-title {
  font-size: 17px;
  font-weight: 500;
  color: #000000;
}

.tag {
  background-color: #07C160;
  color: #FFFFFF;
  font-size: 12px;
  padding: 4px 8px;
  border-radius: 4px;
}

.card-body {
  padding-top: 8px;
}

/* 上午/下午切换
   高度收敛到 36px（外层 3 + 内层 5 + 行高 20 + 内层 5 + 外层 3）。
   原来是 padding 10px + font 15px ≈ 49px，占掉半屏第一屏的可视区域。 */
.period-tabs-container {
  margin: 0 16px;
}

.period-tabs {
  display: flex;
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 3px;
}

.period-tab {
  flex: 1;
  padding: 5px 0;
  text-align: center;
  font-size: 14px;
  line-height: 20px;
  color: #5F5F5F;
  /* 外层圆角 8 − padding 3 = 5，内外才不会错位露白边 */
  border-radius: 5px;
  transition: all 0.2s;
}

.period-tab.active {
  background-color: #07C160;
  color: #FFFFFF;
}

/* 座位网格 */
.seat-table {
  margin: 16px;
}

.seat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8px;
}

/* 座位卡片 - 上下两层结构 */
.seat-item {
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 10px;
  display: flex;
  flex-direction: column;
  min-height: 70px;
  border: 1px solid #E5E5E5;
  position: relative;
}

/* 时间块 - 上层，加深背景 */
.seat-time {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 10px;
  background-color: #E8F5E0;
  border-radius: 4px;
  margin-bottom: 6px;
}

.time-value {
  font-size: 15px;
  font-weight: 600;
  color: #07C160;
}

/* 报名内容 - 下层，一行展示 */
.seat-content {
  flex: 1;
  display: flex;
  align-items: center;
}

.seat-name {
  flex: 1;
  border-radius: 4px;
  padding: 8px 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}

/* 熔炉等级徽章：本页昵称字号 14px（比列表页大），全局 20px 的徽章显得过小 → 页面内放大。
   火晶是 PNG（内容只占画布约 81%，四周透明留白），普通等级是 CSS 圆环（无留白），
   所以画布尺寸要分开给：火晶 26px ≈ 视觉 21px，圆环 22px 才与它视觉等大。 */
.seat-name .frank-l {
  width: 26px;
  height: 26px;
  margin-left: 0;
}

.seat-name .frank-r {
  width: 22px;
  height: 22px;
  margin-left: 0;
  border-width: 2px;
  font-size: 12px;
}

/* 徽章放大后，昵称 + 备注在窄卡片里必须能收缩省略，否则会顶出卡片外
   （flex 子项默认 min-width:auto，不加 min-width:0 不会省略）。备注最不紧要，先让位。 */
.seat-filled-text,
.seat-my-text,
.seat-remark {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.seat-filled-text,
.seat-my-text {
  flex-shrink: 1;
}

.seat-remark {
  flex-shrink: 6;
}

/* 空座位 - 微信绿色 */
.seat-empty {
  background-color: #07C160;
}

.seat-empty-text {
  color: #FFFFFF;
  font-size: 14px;
  font-weight: 600;
}

.seat-empty:active {
  background-color: #06AD56;
}

/* 已占座位（别人） - 灰色 */
.seat-filled {
  background-color: #F5F5F5;
}

.seat-filled-text {
  color: #5F5F5F;
  font-size: 14px;
  font-weight: 500;
}

/* 我的座位 - 蓝色，与空位绿色区分 */
.seat-my {
  background-color: #4A90D9;
}

.seat-my-text {
  color: #FFFFFF;
  font-size: 14px;
  font-weight: 600;
}

.seat-my:active {
  background-color: #3A7BC8;
}

.seat-remark {
  font-size: 12px;
  color: #A6A6A6;
}

.seat-my .seat-remark {
  color: #D0E3F7;
}

/* 我的座位 - 时间块头部也变蓝 */
.seat-item.my-slot {
  border-color: #4A90D9;
}

.seat-item.my-slot .seat-time {
  background-color: #E3EDF7;
}

.seat-item.my-slot .time-value {
  color: #4A90D9;
}

/* 管理员删除按钮 - 在时间块右侧 */
.seat-admin-action {
  padding: 4px 8px;
}

.delete-icon {
  font-size: 16px;
  color: #FA5151;
  font-weight: 600;
}

/* 弹窗样式 - 微信风格 */
/* 弹窗定位层：用 flex 居中，**刻意不用 transform**
   —— 祖先一旦有 transform/filter/contain，就会成为 position:fixed 后代的
   包含块并把它裁掉，官职弹窗里嵌入的 account-nickname 底部面板会被切在弹窗内。 */
.modal-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  box-sizing: border-box;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
}

.modal-container {
  position: relative;
  z-index: 1;
  width: 280px;
  max-width: 100%;
  background-color: #FFFFFF;
  border-radius: 8px;
  /* ⚠️ 刻意不加 overflow:hidden —— 容器里嵌了 account-nickname 的 fixed 底部面板，
     某些渲染引擎会把 fixed 后代一起裁掉。圆角改由 footer 首尾按钮自己兜。 */
}

.modal-header {
  padding: 16px;
  text-align: center;
  background-color: #FFFFFF;
}

.modal-title {
  font-size: 17px;
  font-weight: 500;
  color: #000000;
}

.modal-time {
  font-size: 14px;
  color: #5F5F5F;
  margin-top: 6px;
}

.modal-body {
  padding: 0 16px 16px;
}

.form-group {
  margin-bottom: 12px;
}

.form-label {
  font-size: 14px;
  color: #5F5F5F;
  margin-bottom: 6px;
  display: block;
}

.input {
  width: 100%;
  height: 40px;
  background-color: #F5F5F5;
  border: none;
  border-radius: 4px;
  padding: 0 12px;
  font-size: 15px;
  color: #000000;
}

.modal-footer {
  display: flex;
  border-top: 1px solid #F0F0F0;
}

.modal-footer .btn {
  flex: 1;
  height: 44px;
  line-height: 44px;
  font-size: 17px;
  border-radius: 0;
  background-color: #FFFFFF;
  border: none;
}

/* 兜底圆角：容器即便没有裁剪（避免裁掉固定的底部弹窗），底部两角也不会方出去 */
.modal-footer .btn:first-child {
  border-bottom-left-radius: 8px;
}

.modal-footer .btn:last-child {
  border-bottom-right-radius: 8px;
}

.modal-footer .btn-primary {
  color: #07C160;
  font-weight: 500;
}

.modal-footer .btn-secondary {
  color: #5F5F5F;
  border-right: 1px solid #F0F0F0;
}

.modal-footer .btn-danger {
  color: #FA5151;
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40px;
}

.loading-text {
  color: #5F5F5F;
  font-size: 15px;
}

/* 空状态 */
.empty-state {
  padding: 40px;
  text-align: center;
}

.empty-text {
  color: #A6A6A6;
  font-size: 15px;
}

/* 底部按钮 */
.safe-area-bottom {
  padding: 16px;
  background-color: #F6F6F6;
}

.btn-full {
  width: 100%;
  height: 44px;
  line-height: 44px;
  font-size: 17px;
  border-radius: 8px;
}

.btn-secondary {
  background-color: #FFFFFF;
  color: #5F5F5F;
  border: 1px solid #E5E5E5;
}

/* 间距类 */
.mt-16 {
  margin-top: 16px;
}

.mx-16 {
  margin-left: 16px;
  margin-right: 16px;
}

.p-16 {
  padding: 16px;
}

/* Flex辅助类 */
.flex {
  display: flex;
}

.items-center {
  align-items: center;
}

.justify-between {
  justify-content: space-between;
}

/* 字体辅助类 */
.font-medium {
  font-weight: 500;
}

.font-semibold {
  font-weight: 600;
}

.text-sm {
  font-size: 14px;
}

.text-secondary {
  color: #5F5F5F;
}