/* pages/user/about/about.wxss */
page {
  background-color: #fafbfc;
}

.page {
  min-height: 100vh;
  padding: 48px 16px 32px;
  box-sizing: border-box;
}

/* ---------- 品牌区 ---------- */
.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 36px;
}

.brand-logo {
  width: 88px;
  height: 88px;
  border-radius: 22px;
  background: linear-gradient(135deg, #ffffff 0%, #eaf3fd 100%);
  border: 1px solid #e2ecf8;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 20px rgba(74, 144, 217, 0.14);
  margin-bottom: 18px;
}

.brand-logo-ic {
  width: 54px;
  height: 54px;
}

.brand-name {
  font-size: 19px;
  font-weight: 600;
  color: #1a1a2e;
  letter-spacing: 0.5px;
}

.brand-version {
  margin-top: 8px;
  font-size: 13px;
  color: #9aa3b2;
}

/* ---------- 信息区 ---------- */
.info-card {
  background-color: #FFFFFF;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 10px rgba(26, 26, 46, 0.04);
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15px 16px;
}

.info-row + .info-row {
  border-top: 1px solid #f3f4f7;
}

.info-row-hover {
  background-color: #f7f8fa;
}

.info-label {
  font-size: 14px;
  color: #4a5261;
  flex-shrink: 0;
}

.info-value {
  display: flex;
  align-items: center;
  min-width: 0;
}

.info-link {
  font-size: 14px;
  color: #4A90D9;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.info-arrow {
  font-size: 18px;
  color: #c8ccd4;
  margin-left: 6px;
  line-height: 1;
}

.info-copy {
  font-size: 11px;
  color: #4A90D9;
  background-color: #eef5fd;
  border-radius: 7px;
  padding: 2px 7px;
  margin-left: 8px;
  flex-shrink: 0;
}
