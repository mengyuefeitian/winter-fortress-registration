/* pages/user/my-records/my-records.wxss */
/* 「我的报名」独立页面：报名记录查看 + 取消 */

.page {
  min-height: 100vh;
  background-color: #F6F6F6;
  padding-bottom: 24px;
}

/* 卡片样式 */
.card {
  background-color: #FFFFFF;
  border-radius: 8px;
  margin: 16px;
  padding: 16px;
}

/* ------------------------------------------------------------------
   板块标题：左侧渐变色强调条 + 深色粗体标题 + 右侧条数
   解决「标题对比操作菜单毫无存在感」的层级问题
   ------------------------------------------------------------------ */
.section-header {
  display: flex;
  align-items: center;
  margin: 20px 16px 8px;
}

.section-accent {
  width: 3px;
  height: 15px;
  border-radius: 2px;
  margin-right: 8px;
  flex-shrink: 0;
  background-image: linear-gradient(180deg, #4A90D9 0%, #1a1a2e 100%);
}

.section-title {
  font-size: 16px;
  font-weight: 600;
  color: #1a1a2e;
  line-height: 1.2;
  flex: 1;
}

.section-count {
  font-size: 12px;
  color: #9ca3af;
  flex-shrink: 0;
  margin-left: 8px;
}

/* 当前分区条 */
.zone-bar {
  display: flex;
  align-items: center;
  margin: 16px 16px 0;
  padding: 10px 16px;
  background-color: #FFFFFF;
  border-radius: 8px;
}

.zone-bar-label {
  font-size: 13px;
  color: #9ca3af;
  margin-right: 8px;
  flex-shrink: 0;
}

.zone-bar-value {
  font-size: 14px;
  font-weight: 600;
  color: #1a1a2e;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.zone-bar-code {
  font-size: 12px;
  color: #4A90D9;
  background-color: #f0f7ff;
  border-radius: 4px;
  padding: 2px 8px;
  flex-shrink: 0;
  margin-left: 8px;
}

/* 未登录提示 */
.login-tip {
  margin-top: 32px;
}

.login-tip-title {
  display: block;
  font-size: 16px;
  font-weight: 600;
  color: #1a1a2e;
}

.login-tip-desc {
  display: block;
  font-size: 13px;
  color: #9ca3af;
  margin-top: 4px;
}

/* 紧凑空状态 - 横排，节省空间 */
.empty-compact {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 16px;
  padding: 10px 16px;
  background: #fff;
  border-radius: 8px;
}

.empty-compact-text {
  font-size: 14px;
  color: #A6A6A6;
}

.empty-compact-btn {
  font-size: 13px;
  color: #4A90D9;
  background: #f0f7ff;
  border-radius: 4px;
  padding: 4px 12px;
}

/* 表格容器 */
.table-container {
  background-color: #FFFFFF;
  margin: 0 16px;
  border-radius: 8px;
  overflow: hidden;
}

/* 表格行 */
.table-row {
  display: flex;
  align-items: center;
  padding: 12px 16px;
  border-bottom: 1px solid #F0F0F0;
}

.table-row:last-child {
  border-bottom: none;
}

.table-header-row {
  background-color: #F5F5F5;
  padding: 10px 16px;
}

/* 表格单元格 */
.table-cell {
  flex: 1;
  font-size: 14px;
  color: #000000;
  text-align: left;
  min-width: 0;
}

.table-header-row .table-cell {
  font-size: 13px;
  color: #5F5F5F;
  font-weight: 500;
}

/* 时间单元格 - 多行展示 */
.time-cell {
  flex: 1.5;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
  min-height: 50px;
}

.time-header {
  flex: 1.5;
}

.time-main {
  font-size: 14px;
  font-weight: 500;
  color: #333333;
  line-height: 1.4;
}

.time-tag-inline {
  display: inline-block;
  background-color: #07C160;
  color: #FFFFFF;
  font-size: 11px;
  padding: 2px 6px;
  border-radius: 4px;
}

.time-date-small {
  font-size: 12px;
  color: #A6A6A6;
  line-height: 1.3;
}

/* 操作列 - 固定宽度 */
.action-cell {
  flex: 0 0 50px;
  text-align: center;
}

/* 取消按钮 */
.cancel-btn-small {
  display: inline-block;
  font-size: 12px;
  color: #FA5151;
  padding: 4px 8px;
  border-radius: 4px;
  background-color: #FFF5F5;
}

.cancel-btn-small:active {
  background-color: #FFE8E8;
}

/* 底部说明 */
.list-end-tip {
  margin: 24px 16px 0;
  text-align: center;
  font-size: 12px;
  color: #A6A6A6;
}
