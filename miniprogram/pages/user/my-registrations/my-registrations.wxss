/* pages/user/my-registrations/my-registrations.wxss */
/* 「我的」个人中心：用户信息 + 分区 + 菜单入口 */

.page {
  min-height: 100vh;
  background-color: #F6F6F6;
  padding-bottom: 20px;
}

/* 卡片样式 */
.card {
  background-color: #FFFFFF;
  border-radius: 8px;
  margin: 16px;
  padding: 16px;
}

.card-body {
  display: flex;
  align-items: center;
}

.avatar-lg {
  width: 48px;
  height: 48px;
  border-radius: 24px;
}

.ml-16 {
  margin-left: 16px;
}

.flex-1 {
  flex: 1;
}

.text-lg {
  font-size: 17px;
}

.font-semibold {
  font-weight: 500;
}

.text-secondary {
  color: #5F5F5F;
}

.mt-8 {
  margin-top: 8px;
}

.mt-16 {
  margin-top: 16px;
}

.flex {
  display: flex;
}

.items-center {
  align-items: center;
}

/* 状态点 */
.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 4px;
  margin-right: 6px;
}

.status-active {
  background-color: #07C160;
}

.status-inactive {
  background-color: #A6A6A6;
}

/* 卡片底部 */
.card-footer {
  margin-top: 16px;
  padding-top: 16px;
  border-top: 1px solid #F0F0F0;
}

/* 按钮样式 */
.btn {
  height: 44px;
  line-height: 44px;
  font-size: 17px;
  border-radius: 4px;
  border: none;
}

.btn-full {
  width: 100%;
}

.btn-primary {
  background-color: #07C160;
  color: #FFFFFF;
}

.btn-danger {
  background-color: #FA5151;
  color: #FFFFFF;
}

/* 退出登录 - 缩小版 */
.btn-logout {
  width: auto;
  padding: 0 24px;
  height: 36px;
  line-height: 36px;
  font-size: 14px;
  background-color: #FA5151;
  color: #FFFFFF;
  border-radius: 4px;
  border: none;
}

/* 分区信息条 */
.zone-info-bar {
  margin: 16px 16px 0;
  padding: 8px 16px;
  background-color: rgba(74, 144, 217, 0.08);
  border-radius: 4px;
}

.zone-info-text {
  font-size: 13px;
  color: #4A90D9;
}

/* 分区+信封 垂直排列容器 */
.side-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
  margin-left: 12px;
}

.letter-btn {
  padding: 4px;
}

.letter-icon {
  width: 26px;
  height: 26px;
}

/* ------------------------------------------------------------------
   板块标题：左侧渐变色强调条 + 深色粗体标题
   修复「标题对比操作菜单毫无存在感」的层级问题
   ------------------------------------------------------------------ */
.section-header {
  display: flex;
  align-items: center;
  margin: 24px 16px 10px;
}

.section-accent {
  width: 3px;
  height: 15px;
  border-radius: 2px;
  margin-right: 8px;
  flex-shrink: 0;
  background-image: linear-gradient(180deg, #4A90D9 0%, #1a1a2e 100%);
}

.section-title {
  font-size: 16px;
  font-weight: 600;
  color: #1a1a2e;
  line-height: 1.2;
  flex: 1;
}

/* 菜单卡片 */
.menu-card {
  background-color: #FFFFFF;
  border-radius: 8px;
  margin: 0 16px;
  overflow: hidden;
}

.menu-entry {
  display: flex;
  align-items: center;
  padding: 14px 16px;
}

.menu-entry-hover,
.menu-entry:active {
  background-color: #F7F8FA;
}

.menu-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  margin-right: 12px;
  font-size: 20px;
  background-color: #f0f7ff;
  border-radius: 8px;
  flex-shrink: 0;
}

.menu-content {
  flex: 1;
  min-width: 0;
}

.menu-name {
  display: block;
  font-size: 15px;
  font-weight: 500;
  color: #111827;
  line-height: 1.4;
}

.menu-desc {
  display: block;
  font-size: 13px;
  color: #999999;
  margin-top: 2px;
  line-height: 1.4;
}

.menu-arrow {
  font-size: 22px;
  color: #CCCCCC;
  margin-left: 8px;
  flex-shrink: 0;
}
