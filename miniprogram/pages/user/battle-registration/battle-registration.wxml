<!--pages/user/battle-registration/battle-registration.wxml-->
<view class="container">
  <view class="header">
    <text class="title">国战报名</text>
    <text class="date">{{date}}</text>
    <text class="zone" wx:if="{{zoneName}}">{{zoneName}}</text>
  </view>

  <view class="form">
    <!-- 游戏昵称：与堡垒/兵工厂/峡谷报名一致，可下拉切换已有账号，也可手动输入新昵称
         （新昵称提交后会由 syncFromRegistration 自动存入游戏账号列表） -->
    <view class="form-item">
      <text class="label">游戏昵称</text>
      <view class="form-field">
        <account-nickname accounts="{{accountList}}" value="{{inputNickName}}"
                          selectedId="{{accountSelectedId}}" bind:change="onAccountChange" />
      </view>
    </view>

    <view class="form-item">
      <text class="label">联盟</text>
      <view class="form-field">
        <alliance-picker alliances="{{alliances}}" value="{{allianceIndex}}" variant="plain"
                         bind:change="onAllianceChange" />
      </view>
    </view>

    <view class="form-item">
      <text class="label">熔炉等级</text>
      <view class="level-content">
        <!-- 两个占位格：让熔炉选择框与下面单个兵营块等宽（都占 1/3） -->
        <view class="level-slot"></view>
        <view class="level-slot"></view>
        <view class="level-pick-row lv-row-one" hover-class="level-pick-hover" bindtap="openLevelSheet" data-target="furnace">
          <view class="level-pick-value">
            <block wx:if="{{furnaceView.has}}">
              <image wx:if="{{furnaceView.icon}}" class="level-pick-ic" src="{{furnaceView.icon}}" mode="aspectFit" />
              <view wx:else class="level-pick-ring">{{furnaceView.ring}}</view>
            </block>
            <text wx:else class="level-pick-empty">未选</text>
          </view>
          <image class="level-pick-arrow" src="/images/icon-chevron-right.png" mode="aspectFit" />
        </view>
      </view>
    </view>

    <view class="form-item">
      <text class="label">兵营等级</text>
      <view class="level-content">
        <view class="level-pick-row lv-row-tri lv-row-shield" hover-class="lv-hover-shield" bindtap="openLevelSheet" data-target="shield">
          <image class="level-pick-bic" src="/images/game-account/barracks-shield.png" mode="aspectFit" />
          <view class="level-pick-value">
            <block wx:if="{{shieldView.has}}">
              <view class="lv-badge-wrap">
                <image wx:if="{{shieldView.icon}}" class="level-pick-ic" src="{{shieldView.icon}}" mode="aspectFit" />
                <view wx:else class="level-pick-ring">{{shieldView.ring}}</view>
                <text wx:if="{{shieldView.stage}}" class="lv-stage">{{shieldView.stage}}</text>
              </view>
            </block>
            <text wx:else class="level-pick-empty">—</text>
          </view>
          <image class="level-pick-arrow" src="/images/icon-chevron-right.png" mode="aspectFit" />
        </view>
        <view class="level-pick-row lv-row-tri lv-row-spear" hover-class="lv-hover-spear" bindtap="openLevelSheet" data-target="spear">
          <image class="level-pick-bic" src="/images/game-account/barracks-spear.png" mode="aspectFit" />
          <view class="level-pick-value">
            <block wx:if="{{spearView.has}}">
              <view class="lv-badge-wrap">
                <image wx:if="{{spearView.icon}}" class="level-pick-ic" src="{{spearView.icon}}" mode="aspectFit" />
                <view wx:else class="level-pick-ring">{{spearView.ring}}</view>
                <text wx:if="{{spearView.stage}}" class="lv-stage">{{spearView.stage}}</text>
              </view>
            </block>
            <text wx:else class="level-pick-empty">—</text>
          </view>
          <image class="level-pick-arrow" src="/images/icon-chevron-right.png" mode="aspectFit" />
        </view>
        <view class="level-pick-row lv-row-tri lv-row-bow" hover-class="lv-hover-bow" bindtap="openLevelSheet" data-target="bow">
          <image class="level-pick-bic" src="/images/game-account/barracks-bow.png" mode="aspectFit" />
          <view class="level-pick-value">
            <block wx:if="{{archerView.has}}">
              <view class="lv-badge-wrap">
                <image wx:if="{{archerView.icon}}" class="level-pick-ic" src="{{archerView.icon}}" mode="aspectFit" />
                <view wx:else class="level-pick-ring">{{archerView.ring}}</view>
                <text wx:if="{{archerView.stage}}" class="lv-stage">{{archerView.stage}}</text>
              </view>
            </block>
            <text wx:else class="level-pick-empty">—</text>
          </view>
          <image class="level-pick-arrow" src="/images/icon-chevron-right.png" mode="aspectFit" />
        </view>
      </view>
    </view>

    <view class="form-item">
      <text class="label">兵种数量</text>
      <view class="triple-input-row">
        <view class="triple-cell">
          <text class="triple-label label-shield">盾</text>
          <input type="digit" placeholder="10" maxlength="6" bindinput="onTroopShieldInput" value="{{troopShield}}" />
          <text class="unit-suffix">万</text>
        </view>
        <view class="triple-cell">
          <text class="triple-label label-spear">矛</text>
          <input type="digit" placeholder="20" maxlength="6" bindinput="onTroopSpearInput" value="{{troopSpear}}" />
          <text class="unit-suffix">万</text>
        </view>
        <view class="triple-cell">
          <text class="triple-label label-archer">射</text>
          <input type="digit" placeholder="30" maxlength="6" bindinput="onTroopArcherInput" value="{{troopArcher}}" />
          <text class="unit-suffix">万</text>
        </view>
      </view>
    </view>

    <view class="form-item">
      <text class="label">钻石(万)</text>
      <view class="input-group">
        <input type="digit" placeholder="需要钻石进行加速" maxlength="10" bindinput="onDiamondsInput" value="{{diamonds}}" />
      </view>
    </view>

    <view class="form-item">
      <text class="label">开麦情况</text>
      <picker bindchange="onVoiceChange" value="{{voiceIndex}}" range="{{voiceOptions}}">
        <view class="picker-value picker-select">
          <text>{{voiceOptions[voiceIndex]}}</text>
          <text class="picker-arrow">▾</text>
        </view>
      </picker>
    </view>

    <view class="form-item form-item-confirm">
      <text class="label">参加远征战争</text>
      <view class="confirm-box {{joinExpedition ? 'checked' : ''}}" bindtap="onToggleExpedition">
        <text wx:if="{{joinExpedition}}" class="confirm-check">✓</text>
      </view>
    </view>

    <view class="form-item form-item-confirm">
      <text class="label">参加王城战争</text>
      <view class="confirm-box {{joinRoyalCity ? 'checked' : ''}}" bindtap="onToggleRoyalCity">
        <text wx:if="{{joinRoyalCity}}" class="confirm-check">✓</text>
      </view>
    </view>

    <view class="form-item">
      <text class="label">报名位置</text>
      <picker bindchange="onPositionChange" value="{{positionIndex}}" range="{{positionOptions}}">
        <view class="picker-value picker-select">
          <text>{{positionOptions[positionIndex]}}</text>
          <text class="picker-arrow">▾</text>
        </view>
      </picker>
    </view>
  </view>

  <button class="btn-submit" bindtap="onSubmit" loading="{{loading}}">提交报名</button>
  <button class="btn-share" open-type="share">转发给朋友</button>

  <float-reminder id="entryReminder" />

  <level-picker show="{{levelShow}}" target="{{levelTarget}}" title="{{levelTitle}}" icon="{{levelIcon}}"
                value="{{levelValue}}" bind:confirm="onLevelConfirm" bind:cancel="closeLevelSheet" />
</view>
