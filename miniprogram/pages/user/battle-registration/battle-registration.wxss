/* pages/user/battle-registration/battle-registration.wxss */
.container {
  padding: 30rpx;
  min-height: 100vh;
  background: #fafbfc;
}

.header {
  text-align: center;
  padding: 20rpx 0 40rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a2e;
  display: block;
}

.date {
  font-size: 28rpx;
  color: #4A90D9;
  margin-top: 8rpx;
  display: block;
}

.zone {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.form {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

/* 标签列：只占「4 个汉字 + 少量留白」的宽度，把余下宽度让给右侧的等级选择块
   （原来的 160rpx 会把三个兵营块挤成 155rpx，图标+徽章+箭头根本排不下） */
.label {
  font-size: 28rpx;
  color: #333;
  width: 132rpx;
  flex-shrink: 0;
}

/* 昵称 / 联盟这类复合控件：占满标签右侧的剩余宽度。
   ⚠️ 这里刻意「不做成 flex 容器」——自定义组件节点一旦成为 flex item，
      内部 width:100% 的百分比会失去参照，控件会缩成内容宽度。 */
.form-field {
  flex: 1;
  min-width: 0;
}

.input-group {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.input-group input {
  width: 100%;
  text-align: right;
  font-size: 28rpx;
  color: #333;
}

.input-hint {
  font-size: 20rpx;
  color: #bbb;
  margin-top: 4rpx;
}

/* 开麦情况 / 报名位置用的右侧值样式（联盟已改用弹窗选择器，不再用这个类） */
.picker-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #666;
}

.picker-select {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

.picker-arrow {
  font-size: 22rpx;
  color: #4A90D9;
  margin-left: 4rpx;
}

input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
}

.btn-submit {
  margin-top: 60rpx;
  background: #4A90D9;
  color: #fff;
  border-radius: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
}

.btn-share {
  margin-top: 20rpx;
  background: #fff;
  color: #4A90D9;
  border-radius: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border: 1rpx solid #4A90D9;
}

.triple-input-row {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
}

.triple-cell {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.triple-label {
  font-size: 22rpx;
  font-weight: bold;
  white-space: nowrap;
}

.label-shield { color: #4A90D9; }
.label-spear  { color: #E8703A; }
.label-archer { color: #52C41A; }

.triple-cell input {
  width: 80rpx;
  text-align: center;
  font-size: 26rpx;
  color: #333;
  background: #f7f8fa;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 4rpx 0;
}

.unit-suffix {
  font-size: 22rpx;
  color: #999;
  white-space: nowrap;
}

/* 参战确认行：标签按实际内容宽度展示，避免 6 字被截断 */
.form-item-confirm .label {
  width: auto;
  flex-shrink: 0;
  white-space: nowrap;
}

/* 参战确认勾选框 */
.confirm-box {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #ccc;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  transition: all 0.15s ease;
}

.confirm-box.checked {
  background: #4A90D9;
  border-color: #4A90D9;
}

.confirm-check {
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  line-height: 1;
}

/* ==================== 等级图标选择块 ====================
   一行三槽：熔炉框占 1/3（前两槽为空占位），三个兵营块各占 1/3。
   flex + gap 保证四块等宽；固定 height 保证等高、同一条水平线，
   底色区分盾（蓝）/ 矛（橙）/ 射（绿），与下面兵种数量行的「盾/矛/射」同色系。 */
.level-content {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.level-slot {
  flex: 1;
  min-width: 0;
}

.level-pick-row {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 0 10rpx;
  border-radius: 12rpx;
  background: #f5f7fb;
  border: 1rpx solid #f5f7fb;
}

/* 熔炉行（单块）通用 hover */
.level-pick-hover {
  background: #e9eef6;
  border-color: #e9eef6;
}

/* 三个兵营块各自的底色 + hover 加深 */
.lv-row-shield { background: #EAF3FD; border-color: #CFE2F6; }
.lv-row-spear  { background: #FDF0E8; border-color: #F7D9C6; }
.lv-row-bow    { background: #EEF9E6; border-color: #D8EFC6; }

.lv-hover-shield { background: #DCEBFB; border-color: #BEDAF5; }
.lv-hover-spear  { background: #FAE3D5; border-color: #F0C6AB; }
.lv-hover-bow    { background: #E2F4D3; border-color: #C4E5A9; }

/* 兵营三块：兵营图标固定居左，等级图标在「兵营图标 → 箭头」的剩余空间里居中，
   与兵营图标留出呼吸感；箭头自然被推到最右（value 占满剩余宽度）。 */
.lv-row-tri .level-pick-arrow { margin-left: 6rpx; }

/* 熔炉行（单块、无兵营图标）：等级图标要在整块里正中，
   所以把箭头绝对定位贴右，不让它参与居中计算；value 两侧留等距 padding 防止压到箭头。 */
.lv-row-one { position: relative; }
.lv-row-one .level-pick-value { padding: 0 28rpx; }
.lv-row-one .level-pick-arrow {
  position: absolute;
  right: 10rpx;
  top: 50%;
  transform: translateY(-50%);
  margin-left: 0;
}

/* 三兵营行标：直接用兵营图标代替「盾兵营/矛兵营/射手营」文字（保持居左，尺寸不变） */
.level-pick-bic {
  width: 34rpx;
  height: 34rpx;
  flex: 0 0 auto;
  margin-right: 6rpx;
}

/* 等级展示位：撑满箭头的左侧剩余宽度并水平居中。
   熔炉行（单块）与兵营行（三块）用同一套规则 —— 都是「剩余空间居中」。 */
.level-pick-value {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 等级徽章：比早先的 32rpx 放大到 44rpx。
   注意两种徽章的「实际视觉大小」要接近：
   - 火晶是 PNG（120×120 画布里内容约占 82%~90%，四周有透明留白）→ 给 44rpx 画布，
     实际菱形约 36~40rpx；
   - 标准等级是 CSS 圆环（无留白）→ 给 40rpx，视觉上才和火晶等大。 */
.level-pick-ic {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.level-pick-ring {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2px solid #4A90D9;
  background-color: #FFFFFF;
  color: #4A90D9;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* 等级徽章 + 兵种阶级角标的定位容器（角标要相对徽章定位） */
.lv-badge-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 兵种阶级角标（T11/T12）：挂在等级徽章右下角，与「我的」页 .ga-stage 同一套视觉。
   横向略微出界（right:-10rpx），兵营块里徽章两侧各有约 18rpx 余量，压不到箭头。 */
.lv-stage {
  position: absolute;
  right: -10rpx;
  bottom: -6rpx;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 26rpx;
  color: #FFFFFF;
  background-color: #c8862a;
  border-radius: 6rpx;
  padding: 0 4rpx;
  white-space: nowrap;
}

.level-pick-empty {
  font-size: 20rpx;
  color: #a8b0bd;
  white-space: nowrap;
}

.level-pick-arrow {
  width: 18rpx;
  height: 18rpx;
  margin-left: 6rpx;
  flex-shrink: 0;
}
