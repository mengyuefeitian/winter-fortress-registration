/* pages/user/updates/updates.wxss */
page {
  background-color: #fafbfc;
}

.page {
  min-height: 100vh;
  padding: 16px 16px 32px;
  box-sizing: border-box;
}

.upd-tip {
  font-size: 12px;
  color: #9aa3b2;
  padding: 4px 4px 12px;
}

/* ---------- 版本卡片 ---------- */
.upd-card {
  background-color: #FFFFFF;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 10px rgba(26, 26, 46, 0.04);
}

.upd-item {
  display: flex;
  align-items: center;
  padding: 14px 16px;
}

.upd-item + .upd-item {
  border-top: 1px solid #f3f4f7;
}

.upd-item-hover {
  background-color: #f7f8fa;
}

.upd-main {
  flex: 1;
  min-width: 0;
}

.upd-head {
  display: flex;
  align-items: baseline;
}

.upd-version {
  font-size: 15px;
  font-weight: 600;
  color: #1a1a2e;
}

.upd-date {
  font-size: 11px;
  color: #a8b0bd;
  margin-left: 8px;
}

.upd-title {
  display: block;
  margin-top: 4px;
  font-size: 13px;
  color: #4A90D9;
}

.upd-summary {
  display: block;
  margin-top: 3px;
  font-size: 12px;
  color: #8b94a3;
  line-height: 1.5;
}

.upd-arrow {
  font-size: 20px;
  color: #c8ccd4;
  margin-left: 8px;
  flex-shrink: 0;
  line-height: 1;
}

/* ---------- 空态 ---------- */
.upd-empty {
  padding: 60px 0;
  display: flex;
  justify-content: center;
}

.upd-empty-text {
  font-size: 13px;
  color: #b3bac6;
}
