/* pages/user/bear-pit/bear-pit.wxss */
.bp-container {
  padding: 16px 16px 40px;
}

/* 标题 + 统计 + 报名按钮 */
.bp-hero {
  background: linear-gradient(135deg, #1a1a2e 0%, #0f3460 100%);
  border-radius: 10px;
  padding: 16px;
  margin-bottom: 12px;
}
.bp-hero-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.bp-hero-title {
  font-size: 22px;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2px;
}
.bp-hero-count {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.82);
}
.bp-hero-btn {
  margin-top: 14px;
  height: 40px;
  border-radius: 8px;
  background: #e94560;
  color: #ffffff;
  font-size: 15px;
  font-weight: 600;
  text-align: center;
  line-height: 40px;
}
.bp-hero-btn-disabled {
  background: rgba(255, 255, 255, 0.22);
  color: rgba(255, 255, 255, 0.7);
}

/* 分区 / 联盟 */
.bp-zone-row,
.bp-alliance-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 36px;
}
.bp-alliance-row {
  border-top: 1px solid #f3f4f6;
  padding-top: 8px;
  margin-top: 4px;
}
.bp-label {
  font-size: 13px;
  color: #6b7280;
  flex-shrink: 0;
  margin-right: 12px;
}
.bp-zone-name {
  font-size: 14px;
  color: #111827;
  font-weight: 500;
}
.bp-alliance-picker {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}
.bp-tip {
  font-size: 13px;
  color: #9ca3af;
}

/* 区块标题 */
.bp-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}
.bp-section-title {
  font-size: 15px;
  font-weight: 600;
  color: #111827;
}
.bp-section-count {
  font-size: 12px;
  color: #9ca3af;
}

/* 编号 / 昵称 切换 */
.bp-seg {
  display: flex;
  background: #f3f4f6;
  border-radius: 6px;
  padding: 2px;
}
.bp-seg-item {
  padding: 3px 12px;
  font-size: 12px;
  color: #6b7280;
  border-radius: 5px;
}
.bp-seg-item.on {
  background: #ffffff;
  color: #1a1a2e;
  font-weight: 600;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
}

/* 缩略图 */
.bp-thumb-wrap {
  position: relative;
}
.bp-thumb {
  width: 100%;
  height: 620rpx;
  background: #fafbf7;
  border-radius: 8px;
}
.bp-thumb-hint {
  text-align: center;
  font-size: 12px;
  color: #9ca3af;
  margin-top: 8px;
}
.bp-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 14px;
  margin-top: 10px;
}
.bp-legend-item {
  display: flex;
  align-items: center;
  font-size: 11px;
  color: #6b7280;
}
.bp-legend-dot {
  width: 12px;
  height: 12px;
  border-radius: 3px;
  margin-right: 5px;
}

/* 空态 */
.bp-empty {
  padding: 28px 0;
  text-align: center;
  font-size: 13px;
  color: #9ca3af;
}
.bp-empty-emoji {
  display: block;
  font-size: 26px;
  margin-bottom: 6px;
}

/* 报名人员表格：一行两个 */
.bp-grid {
  display: flex;
  flex-wrap: wrap;
}
.bp-grid-item {
  width: 50%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 7px 6px;
  border-bottom: 1px solid #f3f4f6;
}
.bp-grid-main {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}
.bp-grid-lv {
  font-size: 11px;
  color: #0f3460;
  background: #eef4fb;
  border-radius: 4px;
  padding: 1px 5px;
  margin-right: 6px;
  flex-shrink: 0;
}
.bp-grid-nick {
  font-size: 13px;
  color: #111827;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bp-grid-side {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.bp-grid-seat {
  font-size: 11px;
  color: #9ca3af;
}
.bp-grid-nb {
  font-size: 11px;
  color: #e94560;
  margin-left: 4px;
}
.bp-grid-del {
  margin-left: 6px;
  font-size: 11px;
  color: #e94560;
  border: 1px solid #f7c6cf;
  border-radius: 4px;
  padding: 0 5px;
  line-height: 16px;
  flex-shrink: 0;
}

/* 底部说明 */
.bp-foot {
  margin-top: 16px;
}
.bp-foot-text {
  font-size: 11px;
  color: #9ca3af;
  line-height: 1.7;
}
