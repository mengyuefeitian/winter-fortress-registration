/* pages/user/bear-pit-map/bear-pit-map.wxss */
.bpm-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: #fafbfc;
}

.bpm-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 14px;
  background: #ffffff;
  border-bottom: 1px solid #f3f4f6;
}
.bpm-seg {
  display: flex;
  background: #f3f4f6;
  border-radius: 6px;
  padding: 2px;
}
.bpm-seg-item {
  padding: 4px 16px;
  font-size: 13px;
  color: #6b7280;
  border-radius: 5px;
}
.bpm-seg-item.on {
  background: #ffffff;
  color: #1a1a2e;
  font-weight: 600;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
}
.bpm-actions {
  display: flex;
  align-items: center;
}
.bpm-btn {
  font-size: 13px;
  color: #6b7280;
  border: 1px solid #e5e7eb;
  border-radius: 6px;
  padding: 5px 12px;
  margin-left: 8px;
}
.bpm-btn-primary {
  background: #e94560;
  border-color: #e94560;
  color: #ffffff;
  font-weight: 600;
}

.bpm-canvas-wrap {
  flex: 1;
  position: relative;
  overflow: hidden;
}
.bpm-canvas {
  width: 100%;
  height: 100%;
}
.bpm-loading {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  text-align: center;
  font-size: 13px;
  color: #9ca3af;
}

.bpm-foot {
  flex-shrink: 0;
  padding: 8px 14px 14px;
  text-align: center;
  font-size: 11px;
  color: #9ca3af;
}
