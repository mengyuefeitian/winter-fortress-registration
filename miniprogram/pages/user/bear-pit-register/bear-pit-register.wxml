<!--pages/user/bear-pit-register/bear-pit-register.wxml-->
<view class="bpr-container">

  <view class="card">
    <view class="bpr-sec-head">
      <text class="bpr-sec-title">报名信息</text>
      <text class="bpr-sec-count">已报名 {{memberCount}} / {{capacity}}</text>
    </view>

    <!-- 联盟 -->
    <view class="bpr-row">
      <text class="bpr-label">联盟</text>
      <view class="bpr-control">
        <alliance-picker wx:if="{{alliances.length > 0}}" alliances="{{alliances}}" value="{{allianceIndex}}"
                         bind:change="onAllianceChange" />
        <text wx:else class="bpr-tip">该分区暂无联盟</text>
      </view>
    </view>

    <!-- 昵称 -->
    <view class="bpr-row">
      <text class="bpr-label">昵称</text>
      <view class="bpr-control">
        <account-nickname accounts="{{accountList}}" value="{{nickName}}" selectedId="{{accountSelectedId}}"
                          bind:change="onAccountChange" />
      </view>
    </view>

    <!-- 地心探险等级 -->
    <view class="bpr-row">
      <text class="bpr-label">地心探险</text>
      <view class="bpr-control bpr-control-end">
        <input class="bpr-input" type="number" placeholder="选账号后自动带出" placeholder-class="bpr-ph"
               value="{{dixin}}" bindinput="onDixinInput" />
        <text class="bpr-unit">级</text>
      </view>
    </view>
    <view class="bpr-hint">
      <text>等级越高越靠近熊坑内圈；改了等级要重新报名才会重排座位。</text>
    </view>
  </view>

  <!-- 二选一：按战力排 / 邻居 -->
  <view class="card">
    <view class="bpr-sec-head">
      <text class="bpr-sec-title">排位方式</text>
      <text class="bpr-sec-count">二选一</text>
    </view>

    <view class="bpr-modes">
      <view class="bpr-mode {{mode === 'power' ? 'on' : ''}}" bindtap="selectMode" data-mode="power">
        <text class="bpr-mode-name">按战力排</text>
        <text class="bpr-mode-desc">按地心等级从高到低自动占座</text>
      </view>
      <view class="bpr-mode {{mode === 'neighbor' ? 'on' : ''}} {{canNeighbor ? '' : 'disabled'}}" bindtap="selectMode" data-mode="neighbor">
        <text class="bpr-mode-name">邻居</text>
        <text class="bpr-mode-desc">{{canNeighbor ? '挑一位已报名的人做邻居' : '暂无其他已报名的人可选'}}</text>
      </view>
    </view>

    <!-- 邻居选择：一行 3 个昵称，已被选走的置灰 -->
    <block wx:if="{{mode === 'neighbor'}}">
      <view class="bpr-nb-title">
        <text>选择邻居（一人只能被选一次）</text>
        <text wx:if="{{neighborNick}}" class="bpr-nb-chosen">已选：{{neighborNick}}</text>
      </view>
      <view wx:if="{{neighborList.length === 0}}" class="bpr-nb-empty">
        <text>本联盟还没有其他人报名，只能先按战力排；等有人报名后再来改报即可选邻居。</text>
      </view>
      <view wx:else class="bpr-nb-grid">
        <view wx:for="{{neighborList}}" wx:key="nickName"
              class="bpr-nb-item {{item.taken ? 'taken' : ''}} {{neighborNick === item.nickName ? 'picked' : ''}}"
              bindtap="pickNeighbor" data-index="{{index}}">
          <text class="bpr-nb-nick">{{item.nickName}}</text>
          <text class="bpr-nb-lv">{{item.dixinText}}</text>
        </view>
      </view>
      <view wx:if="{{neighborNick}}" class="bpr-nb-clear" bindtap="clearNeighbor">
        <text>取消选择</text>
      </view>
    </block>
  </view>

  <button class="bpr-submit" bindtap="submit" disabled="{{submitting}}">
    {{submitting ? '提交中…' : '立即报名'}}
  </button>

  <view class="bpr-foot">
    <text>同一个昵称重复报名＝覆盖原来的信息并重排座位；报名后如需取消，请联系盟管。</text>
  </view>
</view>
